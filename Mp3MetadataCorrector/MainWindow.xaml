<Window
    x:Class="Mp3MetadataCorrector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Mp3MetadataCorrector.Models"
    xmlns:helpers="using:Mp3MetadataCorrector.Helpers"
    mc:Ignorable="d"
    Title="MP3 Metadata Corrector">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragOver="OnGridDragOver"
          Drop="OnGridDrop">
        
        <Grid.RowDefinitions>
            <!-- Top Command Header -->
            <RowDefinition Height="Auto" />
            <!-- Collapsible yt-dlg Downloader Panel -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Notification Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="6"
                            Width="36"
                            Height="36">
                        <FontIcon Glyph="&#xE8D6;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MP3 Metadata Corrector" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Search, match, fix ID3 tags &amp; download MP3s" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- yt-dlg Toggle Button -->
                    <Button Click="OnToggleDownloaderClick" ToolTipService.ToolTip="Download MP3 from YouTube / web URL (yt-dlg)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="#E62117" />
                            <TextBlock Text="Download MP3" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <AppBarSeparator />

                    <Button Click="OnOpenFileClick" ToolTipService.ToolTip="Select one or more MP3 files">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Open File" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenFolderClick" ToolTipService.ToolTip="Select a folder with MP3 files">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                            <TextBlock Text="Open Folder" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnClearListClick" ToolTipService.ToolTip="Clear the loaded file queue">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenLogsClick" ToolTipService.ToolTip="Open application diagnostic logs">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                            <TextBlock Text="Logs" />
                        </StackPanel>
                    </Button>
                    <AppBarSeparator />
                    <CheckBox Content="Rename to 'Artist - Title.mp3'"
                              IsChecked="{x:Bind ViewModel.RenameFileOnSave, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="4,0,8,0" />
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveMetadataCommand}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"
                            ToolTipService.ToolTip="Write ID3 tags and album cover into MP3 file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save &amp; Update MP3" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Collapsible yt-dlg Downloader Panel -->
        <Border Grid.Row="1"
                Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfTrue(ViewModel.IsDownloaderVisible), Mode=OneWay}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Spacing="10">
                <!-- Downloader Header & Engine Status -->
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="#E62117" />
                        <TextBlock Text="yt-dlg / YouTube MP3 Downloader" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- yt-dlp Status Chip -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{x:Bind ViewModel.YtDlpStatusText, Mode=OneWay}" FontSize="11" />
                        </Border>
                        <!-- Install button if missing -->
                        <Button Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfFalse(ViewModel.IsYtDlpReady), Mode=OneWay}"
                                Command="{x:Bind ViewModel.InstallYtDlpCommand}"
                                Padding="8,2"
                                FontSize="11">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ProgressRing Width="10" Height="10" IsActive="{x:Bind ViewModel.IsInstallingYtDlp, Mode=OneWay}"
                                              Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfTrue(ViewModel.IsInstallingYtDlp), Mode=OneWay}" />
                                <TextBlock Text="Install yt-dlp" />
                            </StackPanel>
                        </Button>
                        <!-- ffmpeg Status Chip -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{x:Bind ViewModel.FfmpegStatusText, Mode=OneWay}" FontSize="11" />
                        </Border>
                        <!-- Close Downloader Button -->
                        <Button Click="OnToggleDownloaderClick" Padding="4" ToolTipService.ToolTip="Close Downloader panel">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Inputs Row -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <!-- URL Input -->
                        <ColumnDefinition Width="*" />
                        <!-- Output Folder -->
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Download Button -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{x:Bind ViewModel.DownloadUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Paste YouTube, SoundCloud, or media URL (e.g. https://www.youtube.com/watch?v=...)"
                             KeyDown="OnDownloadUrlKeyDown" />

                    <TextBox Grid.Column="1"
                             Text="{x:Bind ViewModel.DownloadFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Save directory (default: D:\Music)" />

                    <Button Grid.Column="2" Click="OnPickDownloadFolderClick" ToolTipService.ToolTip="Browse save folder">
                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                    </Button>

                    <Button Grid.Column="3"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.DownloadMp3Command}"
                            IsEnabled="{x:Bind helpers:VisibilityHelper.Not(ViewModel.IsDownloading), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsDownloading, Mode=OneWay}"
                                          Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfTrue(ViewModel.IsDownloading), Mode=OneWay}" />
                            <FontIcon Glyph="&#xE896;" FontSize="14"
                                      Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfFalse(ViewModel.IsDownloading), Mode=OneWay}" />
                            <TextBlock Text="Download as MP3" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Progress & Status Row -->
                <Grid ColumnSpacing="12" Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfTrue(ViewModel.IsDownloading), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0"
                                 Value="{x:Bind ViewModel.DownloadProgressValue, Mode=OneWay}"
                                 Maximum="100"
                                 VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.DownloadStatusText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Idle status line -->
                <TextBlock Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfFalse(ViewModel.IsDownloading), Mode=OneWay}"
                           Text="{x:Bind ViewModel.DownloadStatusText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: File Queue -->
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="450" />
                <!-- Right Workspace -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- File List Panel -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,12,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Text="MP3 Files Queue" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Empty State for File Queue -->
                    <Border Grid.Row="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfFalse(ViewModel.HasSelectedFile), Mode=OneWay}"
                            Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xEC4F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No MP3 selected" FontWeight="Medium" HorizontalAlignment="Center" />
                            <TextBlock Text="Click 'Open File', 'Download MP3', or drag &amp; drop MP3s here"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Browse MP3" HorizontalAlignment="Center" Click="OnOpenFileClick" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Files List -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                              SelectionMode="Single"
                              CornerRadius="8"
                              BorderThickness="1"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackMetadata">
                                <Grid Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xEC4F;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{x:Bind Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Drop Hint -->
                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            Padding="8,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Drop .mp3 files anywhere to load" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Work Area -->
            <ScrollViewer Grid.Column="1" Padding="16,12,16,16">
                <StackPanel Spacing="16">

                    <!-- SECTION 1: SEARCH & MATCHES -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="Smart Metadata Search" FontWeight="SemiBold" FontSize="15" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableProviders}"
                                              SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                                              Width="140"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Search Input Row -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Enter Artist and Title or Song keywords (e.g. Queen Bohemian Rhapsody)"
                                         KeyDown="OnSearchBoxKeyDown" />

                                <Button Grid.Column="1"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SearchCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                                                      Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfTrue(ViewModel.IsSearching), Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE721;" FontSize="13"
                                                  Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfFalse(ViewModel.IsSearching), Mode=OneWay}" />
                                        <TextBlock Text="Search Online" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Results List / Cards -->
                            <StackPanel Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfTrue(ViewModel.HasSearchResults), Mode=OneWay}" Spacing="8">
                                <TextBlock Text="Search Results (Click 'Apply Match' to populate tags &amp; cover art):"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <ListView ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                          MaxHeight="220"
                                          SelectionMode="None"
                                          BorderThickness="1"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          CornerRadius="6"
                                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SearchResult">
                                            <Grid Padding="8,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Artwork Thumbnail -->
                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind helpers:ImageHelper.SafeImageSource(ArtworkUrl)}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>

                                                <!-- Track Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind TrackSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>

                                                <!-- Provider Badge & Duration -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{x:Bind Source}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind DurationFormatted}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- Apply Button -->
                                                <Button Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Click="OnApplyResultClick"
                                                        Tag="{x:Bind}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8FB;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <TextBlock Text="Apply Match" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: SIDE-BY-SIDE METADATA COMPARISON -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <!-- Original Metadata Card -->
                            <ColumnDefinition Width="*" />
                            <!-- New Metadata / Target Editor Card -->
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: CURRENT / ORIGINAL METADATA -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Current File Tags (Original)" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>

                                <!-- Cover Art & Audio Specs -->
                                <Grid ColumnSpacing="12" Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xEC4F;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfNull(ViewModel.CurrentCoverArtBitmap), Mode=OneWay}" />
                                            <Image Source="{x:Bind ViewModel.CurrentCoverArtBitmap, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.FileName, Mode=OneWay}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.AudioPropertiesSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.FormattedDuration, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedFile.FormattedFileSize, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Current Tags Read-Only Fields -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Title" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox Text="{x:Bind ViewModel.SelectedFile.Title, Mode=OneWay}" IsReadOnly="True" />

                                    <TextBlock Text="Artist" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                    <TextBox Text="{x:Bind ViewModel.SelectedFile.Artist, Mode=OneWay}" IsReadOnly="True" />

                                    <TextBlock Text="Album" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                    <TextBox Text="{x:Bind ViewModel.SelectedFile.Album, Mode=OneWay}" IsReadOnly="True" />

                                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Year" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind ViewModel.SelectedFile.Year, Mode=OneWay}" IsReadOnly="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Track #" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind ViewModel.SelectedFile.TrackString, Mode=OneWay}" IsReadOnly="True" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Genre" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                    <TextBox Text="{x:Bind ViewModel.SelectedFile.Genre, Mode=OneWay}" IsReadOnly="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT: NEW METADATA (EDITABLE TARGET) -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="New Corrected Metadata (To Be Written)" FontWeight="SemiBold" FontSize="14" />
                                    </StackPanel>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="Editable" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Cover Art Management Row -->
                                <Grid ColumnSpacing="12" Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xEB9F;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfNull(ViewModel.EditCoverArtBitmap), Mode=OneWay}" />
                                            <Image Source="{x:Bind ViewModel.EditCoverArtBitmap, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock Text="Album Cover Artwork" FontWeight="Medium" FontSize="12" />
                                        <TextBlock Text="Auto-downloaded high-res front cover" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnChangeCoverArtClick" ToolTipService.ToolTip="Select custom image file (JPG/PNG)">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xEB9F;" FontSize="12" />
                                                    <TextBlock Text="Browse..." FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OnRemoveCoverArtClick" ToolTipService.ToolTip="Remove embedded cover artwork">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    <TextBlock Text="Remove" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Editable Fields Form -->
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Title & Artist -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Title *" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Track Title" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="Artist *" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Artist Name" />
                                    </StackPanel>

                                    <!-- Row 1: Album & Album Artist -->
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Album" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditAlbum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Album Name" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Album Artist" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditAlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Album Artist (Optional)" />
                                    </StackPanel>

                                    <!-- Row 2: Year & Genre -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Release Year" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 1975" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="Genre" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditGenre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Rock, Pop" />
                                    </StackPanel>

                                    <!-- Row 3: Track Number & Track Total -->
                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <TextBlock Text="Track Number" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.EditTrackNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Track" />
                                            <TextBlock Grid.Column="1" Text="/" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="2" Text="{x:Bind ViewModel.EditTrackTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Total" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="1">
                                        <TextBlock Text="Disc Number" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditDiscNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Disc #" />
                                    </StackPanel>

                                    <!-- Row 4: Comment -->
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                        <TextBlock Text="Comment / Tag Note" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind ViewModel.EditComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional comment" />
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Save Button in Card -->
                                <Button Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.SaveMetadataCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"
                                        Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                                                      Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfTrue(ViewModel.IsSaving), Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE74E;" FontSize="14"
                                                  Visibility="{x:Bind helpers:VisibilityHelper.VisibleIfFalse(ViewModel.IsSaving), Mode=OneWay}" />
                                        <TextBlock Text="Save &amp; Update MP3 Tags" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Notification InfoBar -->
        <InfoBar Grid.Row="3"
                 IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsClosable="True" />
    </Grid>
</Window>
