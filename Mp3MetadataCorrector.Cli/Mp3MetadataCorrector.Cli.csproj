<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mp3MetadataCorrector.Cli</RootNamespace>
    <AssemblyName>mp3corrector</AssemblyName>
    <ApplicationIcon>..\Mp3MetadataCorrector\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Mp3MetadataCorrector\Models\TrackMetadata.cs" Link="Models\TrackMetadata.cs" />
    <Compile Include="..\Mp3MetadataCorrector\Models\SearchResult.cs" Link="Models\SearchResult.cs" />
    <Compile Include="..\Mp3MetadataCorrector\Models\DownloadProgressReport.cs" Link="Models\DownloadProgressReport.cs" />
    <Compile Include="..\Mp3MetadataCorrector\Services\FileNameParser.cs" Link="Services\FileNameParser.cs" />
    <Compile Include="..\Mp3MetadataCorrector\Services\Mp3TagService.cs" Link="Services\Mp3TagService.cs" />
    <Compile Include="..\Mp3MetadataCorrector\Services\MetadataSearchService.cs" Link="Services\MetadataSearchService.cs" />
    <Compile Include="..\Mp3MetadataCorrector\Services\YtDownloaderService.cs" Link="Services\YtDownloaderService.cs" />
    <Compile Include="..\Mp3MetadataCorrector\Services\LoggingService.cs" Link="Services\LoggingService.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Mp3MetadataCorrector\tools\**" Link="tools\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
